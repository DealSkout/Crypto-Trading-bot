# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Alpaca (alpaca.markets): trading AND crypto market data, through alpaca-py.
# Use a SEPARATE paper account for this bot (Alpaca lets you open more than one), so it never
# shares a balance or positions with the stock bot. Paper and live keys are different:
# put PAPER keys here first (dashboard: pick the paper account, then API Keys -> Generate).
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Telegram (optional): create a bot with @BotFather, then message it once and read your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# AI coach / guardian reviewer (optional). Claude via the official API, or a local model via Ollama.
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Live trading needs BOTH `mode: live` in config.yaml AND this exact value.
CRYPTOBOT_LIVE_CONFIRM=
